vec3 sample_cone_uniform(vec2 r,float cmax){float c=1.0-(1.0-cmax)*r.y;c=clamp(c,0.0,1.0);return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float pdf_cone_uniform(float cmax){if(cmax>=1.0){return 0.0;}return INV_PI2/(1.0-cmax);}vec3 sample_hemi_uniform(vec2 r){float c=1.0-r.y;return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float pdf_hemi_uniform(void){return INV_PI2;}vec3 sample_sphere_uniform(vec2 r){float c=1.0-(r.y+r.y);return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float pdf_sphere_uniform(void){return INV_PI4;}vec3 sample_cone_cos(vec2 r,float cmax){float cc=1.0-(1.0-cmax*cmax)*r.y;cc=clamp(cc,0.0,1.0);return vec3(cos_sin(r.x*PI2)*sqrt(1.0-cc),sqrt(cc));}float pdf_cone_cos(vec3 wo,float cmax){if(cmax>=1.0){return 0.0;}float c=dot_n(wo);return INV_PI*c/(1.0-cmax*cmax);}vec3 sample_hemi_cos(vec2 r){float cc=1.0-r.y;return vec3(cos_sin(r.x*PI2)*sqrt(1.0-cc),sqrt(cc));}float pdf_hemi_cos(vec3 wo){return INV_PI*dot_n(wo);}vec3 sample_cone_cos_lobe(vec2 r,float n,float cmax){float cmax_n_1=pow(cmax,n+1.0);float c=1.0-(1.0-cmax_n_1)*r.y;c=clamp(c,0.0,1.0);c=pow(c,1.0/(n+1.0));return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float pdf_cone_cos_lobe(vec3 wo,float n,float cmax){float c=dot_n(wo);float c_n=pow(c,n);float cmax_n_1=pow(cmax,n+1.0);return INV_PI2*(n+1.0)*c_n/(1.0-cmax_n_1);}vec3 sample_hemi_cos_lobe(vec2 r,float n){float c=pow(1.0-r.y,1.0/(n+1.0));return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float pdf_hemi_cos_lobe(vec3 wo,float n){float c=dot_n(wo);float c_n=pow(c,n);return INV_PI2*(n+1.0)*c_n;}vec3 sample_ggx(vec2 r,float aa){float cc=(1.0-r.y)/(1.0-(1.0-aa)*r.y);cc=clamp(cc,0.0,1.0);return vec3(cos_sin(r.x*PI2)*sqrt(1.0-cc),sqrt(cc));}float ndf_ggx(vec3 h,float aa){if(aa<=0.0){return 0.0;}float c=dot_n(h);if(c<=0.0){return 0.0;}float g=(1.0-(1.0-aa)*c*c);return INV_PI*aa/(g*g);}vec3 sample_henyey(vec2 r,float g){float c=1.0-(r.y+r.y);if(abs(g)>1e-4){float gg=g*g;float gc=g*c;float t=(1.0-gg)/(1.0+gc);c=(1.0+gg-t*t)/(g+g);}c=clamp(c,-1.0,1.0);return vec3(cos_sin(r.x*PI2)*sqrt(1.0-c*c),c);}float phase_henyey(float g,vec3 wo){if(abs(g)>1.0-1e-4){return 0.0;}float c=dot_n(wo);float gg=g*g;float gc=g*c;float t=1.0+gg-gc-gc;t*=sqrt(t);return INV_PI4*(1.0-gg)/t;}float phase_mie(float g,float c,float cc){float gg=g*g;float gc=g*c;float t=1.0+gg-gc-gc;t*=sqrt(t);return(3.0/8.0/PI)*(1.0-gg)*(1.0+cc)/((2.0+gg)*t);}float phase_ray(float cc){return(3.0/16.0/PI)*(1.0+cc);}vec2 sample_disc(vec2 r){return cos_sin(r.x*PI2)*sqrt(r.y);}vec2 sample_xxx(vec2 r,float bias){return cos_sin(r.x*PI2)*(bias*(r.y+sqrt(r.y))/(1.0-r.y));}vec2 sample_xx(vec2 r,float log0,float log1){return cos_sin(r.x*PI2)*exp(mix(log0,log1,r.y));}

