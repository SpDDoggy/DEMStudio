float g_cook(vec3 i,vec3 o,vec3 h,float h_i){float n_h=dot_n(h);float n_i=dot_n(i);float n_o=dot_n(o);float g=min(n_i,n_o)*n_h/h_i;return clamp(g+g,0.0,1.0);}float w_ggx_cook(vec3 i,vec3 o,vec3 h,float h_i){float n_h=dot_n(h);float n_i=dot_n(i);float n_o=dot_n(o);float g=min(h_i/n_h,n_o+n_o)/n_i;return clamp(g,0.0,2.0);}float schlick_fresnel_1(float Rs,float c){return clamp(Rs+(1.0-Rs)*pow5_c(1.0-c),0.0,1.0);}vec3 schlick_fresnel_3(vec3 Rs,float c){return clamp(Rs+(1.0-Rs)*pow5_c(1.0-c),0.0,1.0);}float schlick_half_1(float c){return clamp(1.0-pow5_c(1.0-0.5*c),0.0,1.0);}float fresnel_i(float e,float ci){if(ci<=0.0){return 1.0;}float ct=1.0-(1.0-ci*ci)*e*e;if(ct<=0.0){return 1.0;}ct=sqrt(ct);vec2 c=vec2(ct,ci);vec2 R=1.0-(c+c)/(c+c.yx*e);return clamp(dot(R,R)*0.5,0.0,1.0);}vec3 spec_refract(vec3 i,vec3 n,float ci,float ct,float e){return(e*ci-ct)*n-e*i;}vec3 spec_reflect(vec3 i,vec3 n,float ci){return(ci+ci)*n-i;}vec3 beer(vec3 K,float d){if(d<=0.0){return vec3(1.0);}return pow(clamp(K,0.0,1.0),vec3(d));}

