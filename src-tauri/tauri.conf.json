{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEMStudio",
  "version": "0.0.1",
  "identifier": "com.demstudio.desktop",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DEMStudio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 580,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
