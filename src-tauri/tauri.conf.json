{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DEMStudio",
  "version": "0.2.0",
  "identifier": "com.demstudio.desktop",
  "build": {
    "frontendDist": "../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DEMStudio",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 580,
        "backgroundColor": "#00000000",
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' blob: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "targets": [
      "nsis"
    ],
    "publisher": "SpDDoggy",
    "shortDescription": "DEM 地形渲染与影像导出",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
